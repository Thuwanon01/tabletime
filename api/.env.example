# ค่าสำหรับรัน api บนเครื่องโดยตรง (go run ./cmd/api) ไม่ใช่ใน docker
# วิธีใช้: cp .env.example .env  (ภายในโฟลเดอร์ api/)
# ต้องเปิด postgres และ keycloak ไว้ก่อน: docker compose up -d postgres keycloak
#
# ⚠️ รหัสทั้งหมดในไฟล์นี้เป็นค่าสำหรับ dev เท่านั้น และต้องตรงกับ .env ที่ root

# ---------- App ----------
APP_ENV=development
APP_NAME=tabletime
APP_PORT=8080
APP_SHUTDOWN=10s

# ---------- Logging ----------
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# ---------- Database ----------
# host port 5532 map ไปที่ 5432 ใน container (compose.yml)
POSTGRES_DSN=postgres://postgres:devonly7c5b98efdbfd0690084a83e4800da2fa@localhost:5532/tabletime?sslmode=disable

# ---------- Keycloak ----------
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_REALM=tabletime
KEYCLOAK_CLIENT_ID=tabletime
KEYCLOAK_CLIENT_SECRET=devonly-q8xGOgAr9x0xWd7Tyee9BEr2x6LLFIvPkneHyNr53p14cuDj
KEYCLOAK_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
FRONTEND_URL=http://localhost:3000

# ---------- Goose (migrations) ----------
# ใช้กับคำสั่ง goose ที่รันในโฟลเดอร์ api/ เช่น goose up
GOOSE_MIGRATION_DIR=./migrations
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:devonly7c5b98efdbfd0690084a83e4800da2fa@localhost:5532/tabletime?sslmode=disable
