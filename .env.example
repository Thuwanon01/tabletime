# ค่าที่ docker compose ใช้ (compose อ่านไฟล์ .env ที่ root ให้อัตโนมัติ)
# วิธีใช้: cp .env.example .env
#
# ⚠️ รหัสทั้งหมดในไฟล์นี้เป็นค่าสำหรับ dev บนเครื่องตัวเองเท่านั้น ห้ามใช้กับระบบจริง

# ---------- Postgres ----------
# ใช้ตัวอักษรกับตัวเลขเท่านั้น เพราะรหัสนี้ถูกนำไปต่อเป็น POSTGRES_DSN (URL) ของ api
POSTGRES_PASSWORD=devonly7c5b98efdbfd0690084a83e4800da2fa

# ---------- Keycloak ----------
# รหัสของ admin console ที่ http://localhost:8180
KEYCLOAK_ADMIN_PASSWORD=devonly7ac2c482240b5ee45a2d94a5
# secret ของ client "tabletime" ใช้ทั้งตอน Keycloak import realm และตอน api คุยกับ Keycloak
KEYCLOAK_CLIENT_SECRET=devonly-q8xGOgAr9x0xWd7Tyee9BEr2x6LLFIvPkneHyNr53p14cuDj
